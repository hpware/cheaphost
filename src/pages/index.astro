---
import Welcome from "../components/Welcome.astro";
import Layout from "../layouts/Layout.astro";
import { Server, MonitorCog, AtSign } from "@lucide/astro";
import { Button } from "../components/ui/button";
import Footer from "../components/Footer.astro";

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<Layout title="免費架">
    <div
        class="absolute inset-0 justify-center flex flex-col text-center items-center space-y-3"
    >
        <span class="text-6xl"
            ><Server
                class="w-20 h-20 hover:-rotate-5 hover:scale-150 hover:text-black/80 transition-all duration-300"
            />免費架</span
        >
        <span
            >限制每人 1 個 HE 的 IPv6 與 1 核心 / 1G 記憶體 的主機<span
                class="text-sm">*1</span
            >
        </span>
        <div class="flex flex-col md:flex-row space-x-2">
            <a href="https://manageut.yhw.tw"
                ><Button className="group hover:bg-primary/80"
                    ><MonitorCog
                        class="group-hover:-rotate-5 group-hover:scale-110 transition-all duration-300"
                    />管理介面</Button
                ></a
            >
            <a href="mailto:askfreehosting@default.tw"
                ><Button className="group hover:bg-primary/80"
                    ><AtSign
                        class="group-hover:-rotate-5 group-hover:scale-110 transition-all duration-300"
                    />註冊帳號</Button
                ></a
            >
        </div>
    </div>
    <div class="min-h-screen"></div>
    <div class="flex flex-col p-5">
        <span
            ><span class="text-sm">*1</span>&nbsp;:&nbsp;伺服器爆掉就沒有了
            (除非有人免費的提供主機 :)</span
        >
    </div>
    <Footer />
</Layout>
